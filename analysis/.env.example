# Copy to analysis/.env (gitignored) and fill in.

# The main booking sheet, read-only. During development: the dev COPY's ID
# (the part of its URL between /d/ and /edit). Never hard-code it in code.
SOURCE_SPREADSHEET_ID=

# A separate spreadsheet the pipeline writes results to (Phase 4). Never the main sheet.
ANALYSIS_SPREADSHEET_ID=

# Path to the service account's JSON key, relative to analysis/ or absolute.
# Keep it under analysis/secrets/ (gitignored) or outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# Optional: censoring date for every model (YYYY-MM-DD). Default: the latest booking date before today.
OBSERVATION_END=

# Optional: where the cached sheet and cleaned frames go. Default: analysis/data
ANALYSIS_DATA_DIR=
