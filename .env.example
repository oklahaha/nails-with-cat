# Copy to .env.local (gitignored) and fill in. Leave the URL empty to use mock data.
# See apps-script/README.md for how to deploy the script.
EXPO_PUBLIC_APPS_SCRIPT_URL=
EXPO_PUBLIC_APPS_SCRIPT_TOKEN=

# Google sign-in. OAuth client IDs from Google Cloud Console. Android needs no
# ID here, only an Android client registered for the package and SHA-1. The iOS
# ID is also read at build time (app.config.ts), so rebuild after changing it.
# Client IDs aren't secret, but never put a client secret here.
# See apps-script/README.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
